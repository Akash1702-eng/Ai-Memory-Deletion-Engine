# =============================================================================
# AI Memory Engine — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Model Configuration ---
MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
MODEL_CACHE_DIR=./models/base
MODEL_CHECKPOINT_DIR=./models/checkpoints
ACTIVE_MODEL_VERSION=v1.0

# --- Hugging Face ---
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_USERNAME=your_hf_username
HF_FINETUNE_REPO=qwen2.5-1.5b-memory-adapter
HF_UNLEARN_REPO=qwen2.5-1.5b-unlearned-adapter

# --- Training Configuration ---
TRAINING_EPOCHS=3
TRAINING_BATCH_SIZE=4
TRAINING_LEARNING_RATE=2e-4
TRAINING_MAX_SEQ_LENGTH=256
USE_LORA=true
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# --- Unlearning Configuration ---
UNLEARNING_EPOCHS=5
UNLEARNING_LEARNING_RATE=1e-4

# --- Kaggle (for remote GPU training) ---
# Get your API key from https://www.kaggle.com/settings → API
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --- HF Data Repo (training data upload) ---
HF_DATA_REPO=memory-engine-data

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
